{
  "name": "getitdone",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @getitdone/web dev",
    "dev:api": "pnpm --filter @getitdone/api dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @getitdone/api db:generate",
    "db:migrate:local": "pnpm --filter @getitdone/api db:migrate:local"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "turbo": "^2.10.8",
    "typescript": "^5.6.0"
  }
}
