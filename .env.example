# Copy to .env (root) and to apps/api/.dev.vars as needed.
#
# --- Cloudflare (deploy) ---
# Set these as GitHub Actions secrets, never commit them.
# CLOUDFLARE_API_TOKEN=your_api_token
# CLOUDFLARE_ACCOUNT_ID=your_account_id

# --- Frontend (apps/web/.env) ---
# Public base URL of the deployed API Worker. Omit to use the Vite dev proxy (/api).
# VITE_API_URL=https://api.getitdone.example.workers.dev

# --- API (apps/api/.dev.vars for local secrets) ---
# APP_ENV=development
# SESSION_COOKIE_SECURE=false
