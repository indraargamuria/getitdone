{
  "name": "@getitdone/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply getitdone-db-local --local",
    "db:migrate:preview": "wrangler d1 migrations apply getitdone-db-preview --env preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply getitdone-db --env production --remote"
  },
  "dependencies": {
    "@getitdone/shared": "workspace:^",
    "@hono/zod-validator": "^0.9.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "drizzle-kit": "^0.31.10",
    "miniflare": "5.20260801.0-alpha",
    "vitest": "^2.1.9",
    "wrangler": "^4.119.0"
  }
}
